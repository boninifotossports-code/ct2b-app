generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROFESSOR
  TREINADOR
  COORDENADOR
  RESPONSAVEL
  ATLETA
}

model Usuario {
  id        String   @id @default(uuid())
  usuario   String   @unique // Login utilizado (ex: 'arthur', 'professor')
  nome      String
  senha     String   // Senha em texto ou hash
  role      Role     @default(ADMIN)
  telefone  String?
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // Vínculo opcional se o usuário for pai/responsável de um atleta específico
  atletaId  String?
  atleta    Atleta?  @relation(fields: [atletaId], references: [id])
}

model Atleta {
  id              String      @id @default(uuid())
  nome            String
  dataNascimento  DateTime?
  categoria       String?     // Ex: "Sub-9", "Sub-10", "Sub-15"
  posicao         String?     // Ex: "Goleiro", "Fixo", "Ala"
  ativo           Boolean     @default(true)
  criadoEm        DateTime    @default(now())
  atualizadoEm    DateTime    @updatedAt

  // Relações
  usuarios        Usuario[]
  presencas       Presenca[]
  planos          PlanoAtleta[]
  feedbacks       Feedback[]
}

model Plano {
  id              String        @id @default(uuid())
  nome            String        // Ex: "Mensal 2x", "Semestral"
  valor           Float
  descricao       String?
  ativo           Boolean       @default(true)
  atletas         PlanoAtleta[]
}

model PlanoAtleta {
  id          String   @id @default(uuid())
  atletaId    String
  planoId     String
  dataInicio  DateTime @default(now())
  dataFim     DateTime?
  status      String   @default("ATIVO") // ATIVO, CANCELADO, PENDENTE

  atleta      Atleta   @relation(fields: [atletaId], references: [id], onDelete: Cascade)
  plano       Plano    @relation(fields: [planoId], references: [id], onDelete: Cascade)
}

model Treino {
  id          String     @id @default(uuid())
  titulo      String     // Ex: "Treino Técnico de Goleiros"
  categoria   String?    // Ex: "Fut 7", "Sub-10"
  data        DateTime
  horario     String?
  descricao   String?
  conteudo    String?    // Descritivo dos blocos de treino
  presencas   Presenca[]
  criadoEm    DateTime   @default(now())
}

model Presenca {
  id        String   @id @default(uuid())
  atletaId  String
  treinoId  String
  presente  Boolean  @default(false)
  justificativa String?
  criadoEm  DateTime @default(now())

  atleta    Atleta   @relation(fields: [atletaId], references: [id], onDelete: Cascade)
  treino    Treino   @relation(fields: [treinoId], references: [id], onDelete: Cascade)

  @@unique([atletaId, treinoId])
}

model Feedback {
  id          String   @id @default(uuid())
  atletaId    String
  titulo      String
  nota        Float?
  comentario  String
  autor       String   // Nome do treinador/professor
  criadoEm    DateTime @default(now())

  atleta      Atleta   @relation(fields: [atletaId], references: [id], onDelete: Cascade)
}

model Exercicio {
  id          String   @id @default(uuid())
  nome        String
  categoria   String   // Aquecimento, Técnico, Tático, Físico
  descricao   String?
  videoUrl    String?
  criadoEm    DateTime @default(now())
}